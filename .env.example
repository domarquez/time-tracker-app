# Neon / Postgres connection string (SSL handled in server.js)
DATABASE_URL=postgres://usuario:contraseña@host:5432/nombre_db
PORT=3000

# --- WhatsApp al admin ---
# Sin proveedor configurado: no se envía nada (solo log).
# Proveedor por defecto si hay EVOLUTION_BASE_URL + EVOLUTION_API_KEY: Evolution API v2 (self-hosted)
EVOLUTION_BASE_URL=https://evolution.midominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=precios-ferreterias
# Único destinatario de las alertas
ADMIN_WHATSAPP_PHONE=+59167827075
# WHATSAPP_PROVIDER=evolution      # evolution | callmebot | textmebot (auto si se omite)
# WHATSAPP_ENABLED=true            # default: true si el proveedor está configurado
# WHATSAPP_REALTIME_ENABLED=true   # false = solo resúmenes, sin alertas PRENDER/APAGAR
# WHATSAPP_MIN_GAP_MS=8000         # separación mínima entre mensajes (la instancia es compartida)
# DAILY_SUMMARY_TIME=21:30         # lun–sáb, hora La Paz
# WEEKLY_SUMMARY_TIME=21:45        # sábado, hora La Paz
# LEFT_ON_ALERT_TIME=20:00         # aviso "sigue prendido", hora La Paz
# WHATSAPP_WORKER_ALERTS=true      # avisos también al WhatsApp del trabajador
# START_REMINDER_TIMES=08:00,10:00,12:00  # recordatorio de inicio (lun–sáb)
# START_REMINDER_ACTIVE_DAYS=30
# APP_URL=https://time-tracker-app-production-2a17.up.railway.app
# WHATSAPP_JITTER_MS=3000          # espera aleatoria extra entre mensajes
# NIGHT_ASK_EVERY_MIN=60           # preguntas después de las 23:00
# NIGHT_ASK_TIMEOUT_MIN=15         # minutos para responder antes del corte
# MAX_SHIFT_HOURS=16               # tope de turno (corte automático)
# Alternativas (no usadas por defecto):
# CALLMEBOT_APIKEY=                # WHATSAPP_PROVIDER=callmebot
# TEXTMEBOT_APIKEY=                # WHATSAPP_PROVIDER=textmebot

# Administración
# ADMIN_PASSWORD=                  # ¡definila! sin ella se usa "admin"
# SEED_WORKERS=Nombre:+591XXXXXXXX,Otro:7XXXXXXX   # alta idempotente al arrancar
# WHATSAPP_WORKER_RECEIPTS=true    # comprobante de inicio/fin al trabajador
# WORKER_WEEKLY_RECEIPT=true       # sábado 21:45 horas (y Bs) a cada trabajador
# ADMIN_START_REMINDER_TIMES=08:00,08:30,09:00,09:30,10:00,10:30,11:30,12:30,13:30,14:30
# EVOLUTION_WEBHOOK_TOKEN=         # activa POST /webhook/evolution?token=...
